import kotlin.Int;
import kotlin.Boolean;

CREATE TABLE food_items (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL DEFAULT 'Neznámé jídlo',
    calories INTEGER AS Int NOT NULL DEFAULT 0,
    protein INTEGER AS Int NOT NULL DEFAULT 0,
    fat INTEGER AS Int NOT NULL DEFAULT 0,
    carbs INTEGER AS Int NOT NULL DEFAULT 0,
    portion INTEGER AS Int NOT NULL DEFAULT 1,
    healthScore INTEGER AS Int NOT NULL DEFAULT 0,
    createdAt TEXT NOT NULL,
    updatedAt TEXT NOT NULL,
    localImagePath TEXT NOT NULL,
    loading INTEGER AS Boolean NOT NULL DEFAULT 1,
    isCustom INTEGER AS Boolean NOT NULL DEFAULT 0
);

CREATE INDEX IF NOT EXISTS idx_food_items_created_at ON food_items(createdAt);
CREATE INDEX IF NOT EXISTS idx_food_items_updated_at ON food_items(updatedAt);
CREATE INDEX IF NOT EXISTS idx_food_items_is_custom ON food_items(isCustom);
CREATE INDEX IF NOT EXISTS idx_food_items_name_nocase ON food_items(name COLLATE NOCASE);

getAllFoodItems:
SELECT * FROM food_items ORDER BY createdAt DESC;

getFoodItemsForDate:
SELECT * FROM food_items WHERE date(createdAt) = ? ORDER BY createdAt DESC;

getTotalCaloriesForDate:
SELECT SUM(calories) FROM food_items WHERE date(createdAt) = ?;

getTotalFatsForDate:
SELECT SUM(fat) FROM food_items WHERE date(createdAt) = ?;

getTotalCarbsForDate:
SELECT SUM(carbs) FROM food_items WHERE date(createdAt) = ?;

getTotalProteinForDate:
SELECT SUM(protein) FROM food_items WHERE date(createdAt) = ?;

getMacroTotalsForDate:
SELECT
    COALESCE(SUM(calories), 0) AS totalCalories,
    COALESCE(SUM(protein), 0) AS totalProtein,
    COALESCE(SUM(carbs), 0) AS totalCarbs,
    COALESCE(SUM(fat), 0) AS totalFat
FROM food_items WHERE date(createdAt) = ?;

insertFoodItem:
INSERT INTO food_items (name, calories, protein, fat, carbs, portion, healthScore, createdAt, updatedAt, localImagePath, loading, isCustom)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

lastInsertRowId:
SELECT last_insert_rowid();

updateFoodItem:
UPDATE food_items SET
    name = ?,
    calories = ?,
    protein = ?,
    fat = ?,
    carbs = ?,
    portion = ?,
    healthScore = ?,
    updatedAt = ?,
    localImagePath = ?,
    loading = ?
WHERE id = ?;

deleteFoodItem:
DELETE FROM food_items WHERE id = ?;

getFoodItem:
SELECT * FROM food_items WHERE id = ?;

getDailyMacroTotalsInRange:
SELECT
    date(createdAt) AS day,
    SUM(protein) AS totalProtein,
    SUM(carbs) AS totalCarbs,
    SUM(fat) AS totalFat
FROM food_items
WHERE date(createdAt) BETWEEN ? AND ?
GROUP BY date(createdAt)
ORDER BY day ASC;

getDistinctFoodsByName:
SELECT f.*
FROM food_items f
INNER JOIN (
    SELECT name, MAX(updatedAt) AS latestUpdate
    FROM food_items
    WHERE loading = 0 AND name != 'Neznámé jídlo'
    GROUP BY name
) latest ON f.name = latest.name AND f.updatedAt = latest.latestUpdate
ORDER BY f.updatedAt DESC
LIMIT 50;

getDistinctFoodDates:
SELECT DISTINCT date(createdAt) AS day FROM food_items ORDER BY day DESC;

getCustomFoods:
SELECT * FROM food_items WHERE isCustom = 1 ORDER BY updatedAt DESC;

searchCustomFoods:
SELECT * FROM food_items WHERE isCustom = 1 AND name LIKE ? || '%' COLLATE NOCASE ORDER BY updatedAt DESC;

searchDistinctFoodsByName:
SELECT f.*
FROM food_items f
INNER JOIN (
    SELECT name, MAX(updatedAt) AS latestUpdate
    FROM food_items
    WHERE loading = 0 AND name != 'Neznámé jídlo'
    AND name LIKE ? || '%' COLLATE NOCASE
    GROUP BY name
) latest ON f.name = latest.name AND f.updatedAt = latest.latestUpdate
ORDER BY f.updatedAt DESC
LIMIT 50;
